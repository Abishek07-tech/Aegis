APP_ENV=production
POSTGRES_DB=risk
POSTGRES_USER=risk
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://risk:replace-with-a-long-random-database-password@postgres:5432/risk
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
REDIS_URL=redis://redis:6379/0
SEARXNG_URL=http://searxng:8080
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=LiquidAI/lfm2.5-350m
MAX_AI_CANDIDATES=5
# Keep the prompt bounded to ranked evidence; this fits the 2048-token Ollama context.
MAX_AI_EVIDENCE_ITEMS=8
MAX_AI_CONTEXT_CHARS=6000
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_OUTPUT_TOKENS=256
CORS_ORIGINS=https://your-domain.example
VITE_API_URL=/api
ENABLE_DEMO_ACCOUNT=true
DEMO_USER_EMAIL=demo@brand.local
DEMO_USER_PASSWORD=replace-with-a-long-random-demo-password
