# Aegis API environment variables

# PostgreSQL connection string (Prisma) — placeholder only, replace with your own
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aegis?schema=public"

# Port the API listens on
PORT=4000

# development | production | test
NODE_ENV=development

# Comma-separated list of exact allowed CORS origins
CORS_ORIGIN=http://localhost:5173

# Optional AI investigator provider (Task 16).
# Leave AEGIS_AI_API_KEY unset/empty — the default — and the API runs the
# deterministic fallback investigator with no external calls. Never commit keys.
# AEGIS_AI_API_KEY=
# AEGIS_AI_BASE_URL=https://api.openai.com/v1
# AEGIS_AI_MODEL=gpt-4o-mini
# AEGIS_AI_TIMEOUT_MS=8000
#
# When AEGIS_AI_API_KEY is set, the API integrates AI analysis into the scan
# workflow: after collection discovers candidate assets, each new candidate is
# analyzed automatically. Results are persisted on the CandidateAsset record
# (aiAnalysisStatus, aiThreatIntent, aiRiskScore, aiConfidence, aiSummary,
# aiAnalyzedAt). Scans complete independently of AI availability — AI failure
# never fails a scan.
#
# AI analysis can also be triggered on demand:
#   POST /api/candidates/:candidateId/analyze/ai    (rate-limited: 10 req/min)
#   GET  /api/candidates/:candidateId/ai-analysis   (fetch persisted results)
#
# Cost consideration: each scan of N new candidates triggers N AI requests.
# Set AEGIS_AI_TIMEOUT_MS and use a budget-conscious model (default gpt-4o-mini).
# The provider abstraction supports any OpenAI-compatible chat-completions
# endpoint (OpenAI, Azure OpenAI, local models, etc.).

# Optional SearXNG-compatible JSON search endpoint. Use the complete /search
# endpoint URL for an authorized instance; no provider means scans are UNAVAILABLE.
# AEGIS_SEARCH_URL=https://search.example.invalid/search
# AEGIS_SEARCH_TIMEOUT_MS=8000
# AEGIS_SEARCH_MIN_INTERVAL_MS=500
