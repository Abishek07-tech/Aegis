# Aegis API environment variables

# PostgreSQL connection string (Prisma) — placeholder only, replace with your own
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aegis?schema=public"

# Port the API listens on
PORT=4000

# development | production | test
NODE_ENV=development

# Comma-separated list of exact allowed CORS origins
CORS_ORIGIN=http://localhost:5173

# Optional AI investigator provider (Task 16).
# Leave AEGIS_AI_API_KEY unset/empty — the default — and the API runs the
# deterministic fallback investigator with no external calls. Never commit keys.
# AEGIS_AI_API_KEY=
# AEGIS_AI_BASE_URL=https://api.openai.com/v1
# AEGIS_AI_MODEL=gpt-4o-mini
# AEGIS_AI_TIMEOUT_MS=8000

# Optional SearXNG-compatible JSON search endpoint. Use the complete /search
# endpoint URL for an authorized instance; no provider means scans are UNAVAILABLE.
# AEGIS_SEARCH_URL=https://search.example.invalid/search
# AEGIS_SEARCH_TIMEOUT_MS=8000
# AEGIS_SEARCH_MIN_INTERVAL_MS=500
