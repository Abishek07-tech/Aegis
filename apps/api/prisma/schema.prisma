// Aegis database schema — Prisma 7
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL comes from DATABASE_URL via prisma7.config.ts
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets     OfficialAsset[]
  candidates CandidateAsset[]
}

model OfficialAsset {
  id        String   @id @default(cuid())
  brandId   String
  type      String
  value     String
  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([type])
}

model CandidateAsset {
  id          String   @id @default(cuid())
  type        String
  value       String
  name        String?
  description String?
  brandId     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceUrl  String?
  collectedAt DateTime?

  aiAnalysisStatus String   @default("PENDING")
  aiThreatIntent   String?
  aiRiskScore      Int?
  aiConfidence     Float?
  aiSummary        String?
  aiAnalyzedAt     DateTime?

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([brandId])
  @@index([sourceUrl])
  @@index([aiAnalysisStatus])
  @@unique([brandId, sourceUrl])
}

model ScanJob {
  id            String   @id @default(cuid())
  status        String   @default("RUNNING")
  scope         String
  brandId       String?
  provider      String?
  progress      Int      @default(0)
  assetsAnalyzed Int     @default(0)
  findings      Int      @default(0)
  errors        Int      @default(0)
  errorMessage  String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([status])
  @@index([brandId])
}
